// SPDX-License-Identifier: Apache-2.0
// Covenant: Confidential Debt-to-Collateral Covenant Verification on Midnight.
// Under-collateralized and private debt covenants with zero balance disclosures.

pragma language_version >= 0.23;

import CompactStandardLibrary;

export enum LoanStatus { pending, funded, liquidated, repaid, defaulted }

export struct LoanTerms {
  borrowAmount: Uint<64>;
  collateralAmount: Uint<64>;
  minRatioBps: Uint<32>;     // e.g. 15000 = 150.00%
  dueTimestamp: Uint<32>;
  currency: Uint<16>;
}

export struct LoanRecord {
  borrower: Bytes<32>;
  lender: Bytes<32>;
  arbiter: Bytes<32>;
  termsCommitment: Bytes<32>;
  status: LoanStatus;
  createdAt: Uint<32>;
  dueTimestamp: Uint<32>;
  minRatioBps: Uint<32>;
  currency: Uint<16>;
}

struct LoanCommitmentInput {
  domain: Bytes<32>;
  terms: LoanTerms;
  borrower: Bytes<32>;
  salt: Bytes<32>;
}

struct CollateralCommitmentInput {
  domain: Bytes<32>;
  borrower: Bytes<32>;
  currency: Uint<16>;
  collateralAmount: Uint<64>;
  salt: Bytes<32>;
}

struct AttestationRecordKeyInput {
  domain: Bytes<32>;
  borrower: Bytes<32>;
  currency: Uint<16>;
}

// ---------------------------------------------------------------------------
// Ledger State
// ---------------------------------------------------------------------------

export sealed ledger admin: Bytes<32>;
export ledger certifiedOracles: Set<Bytes<32>>;
export ledger certifiedCustodians: Set<Bytes<32>>;
export ledger assetPrices: Map<Uint<16>, Uint<64>>;
export ledger attestedCollateralRegistry: Map<Bytes<32>, Bytes<32>>;
export ledger loans: Map<Bytes<32>, LoanRecord>;
export ledger loanCount: Counter;
export ledger settlementNullifiers: Map<Bytes<32>, Boolean>;
export ledger liquidationProofs: Map<Bytes<32>, Bytes<32>>;

// ---------------------------------------------------------------------------
// Witnesses (Private Inputs)
// ---------------------------------------------------------------------------

witness privateKey(): Bytes<32>;
witness loanTerms(): LoanTerms;
witness loanSalt(): Bytes<32>;
witness collateralSalt(): Bytes<32>;

// ---------------------------------------------------------------------------
// Pure Circuits
// ---------------------------------------------------------------------------

export pure circuit borrowerKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "covenant:borrower:v1"), sk]);
}

export pure circuit lenderKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "covenant:lender:v1"), sk]);
}

export pure circuit arbiterKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "covenant:arbiter:v1"), sk]);
}

export pure circuit oracleKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "covenant:oracle:v1"), sk]);
}

export pure circuit custodianKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "covenant:custodian:v1"), sk]);
}

export pure circuit loanCommitment(terms: LoanTerms, borrower: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<LoanCommitmentInput>(LoanCommitmentInput {
    domain: pad(32, "covenant:loan:v1"),
    terms: terms,
    borrower: borrower,
    salt: salt
  });
}

export pure circuit collateralCommitment(
  borrower: Bytes<32>,
  currency: Uint<16>,
  amount: Uint<64>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentHash<CollateralCommitmentInput>(CollateralCommitmentInput {
    domain: pad(32, "covenant:collateral:v1"),
    borrower: borrower,
    currency: currency,
    collateralAmount: amount,
    salt: salt
  });
}

export pure circuit attestationRecordKey(borrower: Bytes<32>, currency: Uint<16>): Bytes<32> {
  return persistentHash<AttestationRecordKeyInput>(AttestationRecordKeyInput {
    domain: pad(32, "covenant:custodian_record:v1"),
    borrower: borrower,
    currency: currency
  });
}

export pure circuit covenantNullifier(salt: Bytes<32>, loanId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "covenant:nullifier:v1"), loanId, salt]);
}

export pure circuit settlementReceipt(commitment: Bytes<32>, recipient: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "covenant:settlement:v1"), commitment, recipient]);
}

// Range check / ratio predicate:
// collateralValue = collateral * price * 10000
// requiredValue = borrow * minRatioBps
export pure circuit meetsCovenantRatio(collateral: Uint<64>, price: Uint<64>, borrow: Uint<64>, minRatioBps: Uint<32>): Boolean {
  const collateralValue = collateral * price * 10000;
  const requiredValue = borrow * (minRatioBps as Uint<64>);
  return collateralValue >= requiredValue;
}

// ---------------------------------------------------------------------------
// State Transition Circuits
// ---------------------------------------------------------------------------

constructor() {
  admin = disclose(arbiterKey(privateKey()));
}

export circuit registerOracle(oraclePublic: Bytes<32>): [] {
  const pKey = privateKey();
  assert(disclose(arbiterKey(pKey) == admin), "Only admin can register oracle");
  certifiedOracles.insert(disclose(oraclePublic));
}

export circuit registerCustodian(custodianPublic: Bytes<32>): [] {
  const pKey = privateKey();
  assert(disclose(arbiterKey(pKey) == admin), "Only admin can register custodian");
  certifiedCustodians.insert(disclose(custodianPublic));
}

export circuit postPrice(currency: Uint<16>, price: Uint<64>): [] {
  const pKey = privateKey();
  const caller = disclose(oracleKey(pKey));
  assert(certifiedOracles.member(caller), "Caller not certified oracle");
  assert(disclose(price > 0), "Price must be positive");
  assetPrices.insert(disclose(currency), disclose(price));
}

export circuit attestCollateral(
  borrowerPublic: Bytes<32>,
  currency: Uint<16>,
  commitment: Bytes<32>
): [] {
  const pKey = privateKey();
  const caller = disclose(custodianKey(pKey));
  assert(certifiedCustodians.member(caller), "Caller not certified custodian");
  const recordKey = disclose(attestationRecordKey(borrowerPublic, currency));
  attestedCollateralRegistry.insert(recordKey, disclose(commitment));
}

export circuit requestLoan(
  loanId: Bytes<32>,
  borrowerPublic: Bytes<32>,
  lenderPublic: Bytes<32>,
  arbiterPublic: Bytes<32>,
  timestamp: Uint<32>
): [] {
  const id = disclose(loanId);
  assert(!loans.member(id), "Loan record already exists");

  const pKey = privateKey();
  assert(disclose(borrowerKey(pKey) == borrowerPublic), "Invalid borrower key");

  const terms = loanTerms();
  const salt = loanSalt();
  const cSalt = collateralSalt();

  assert(disclose(terms.borrowAmount > 0), "Borrow amount must be positive");
  assert(disclose(terms.collateralAmount > 0), "Collateral amount must be positive");
  assert(disclose(terms.dueTimestamp > timestamp), "Due date must be in future");

  // Verify on-chain collateral attestation by certified custodian
  const expectedCollateralCommitment = collateralCommitment(
    borrowerPublic,
    terms.currency,
    terms.collateralAmount,
    cSalt
  );
  const recordKey = disclose(attestationRecordKey(borrowerPublic, terms.currency));
  assert(attestedCollateralRegistry.member(recordKey), "No custodian collateral attestation found");
  assert(disclose(expectedCollateralCommitment == attestedCollateralRegistry.lookup(recordKey)),
         "Collateral commitment mismatch");

  // Verify covenant ratio against certified on-chain oracle price feed
  const curr = disclose(terms.currency);
  assert(assetPrices.member(curr), "Price feed missing for currency");
  const currentPrice = assetPrices.lookup(curr);
  assert(disclose(meetsCovenantRatio(terms.collateralAmount, currentPrice, terms.borrowAmount, terms.minRatioBps)),
         "Collateral ratio below minimum threshold");

  const commitment = disclose(loanCommitment(terms, borrowerPublic, salt));

  const record = LoanRecord {
    borrower: disclose(borrowerPublic),
    lender: disclose(lenderPublic),
    arbiter: disclose(arbiterPublic),
    termsCommitment: commitment,
    status: LoanStatus.pending,
    createdAt: disclose(timestamp),
    dueTimestamp: disclose(terms.dueTimestamp),
    minRatioBps: disclose(terms.minRatioBps),
    currency: curr
  };

  loans.insert(id, record);
  loanCount.increment(1);
}

export circuit fundLoan(loanId: Bytes<32>): [] {
  const id = disclose(loanId);
  assert(loans.member(id), "Loan not found");
  const record = loans.lookup(id);
  assert(record.status == LoanStatus.pending, "Loan is not pending funding");

  const pKey = privateKey();
  assert(disclose(lenderKey(pKey) == record.lender), "Only designated lender can fund");

  const updated = LoanRecord {
    borrower: record.borrower,
    lender: record.lender,
    arbiter: record.arbiter,
    termsCommitment: record.termsCommitment,
    status: LoanStatus.funded,
    createdAt: record.createdAt,
    dueTimestamp: record.dueTimestamp,
    minRatioBps: record.minRatioBps,
    currency: record.currency
  };

  loans.insert(id, updated);
}

export circuit repayLoan(loanId: Bytes<32>): Bytes<32> {
  const id = disclose(loanId);
  assert(loans.member(id), "Loan not found");
  const record = loans.lookup(id);
  assert(record.status == LoanStatus.funded, "Loan not active funded");

  const terms = loanTerms();
  const salt = loanSalt();
  const computed = loanCommitment(terms, record.borrower, salt);
  assert(disclose(computed == record.termsCommitment), "Terms commitment mismatch");

  const pKey = privateKey();
  assert(disclose(borrowerKey(pKey) == record.borrower), "Only borrower can repay");

  const nullifier = disclose(covenantNullifier(salt, id));
  assert(!settlementNullifiers.member(nullifier), "Loan already settled");

  const receipt = disclose(settlementReceipt(record.termsCommitment, record.borrower));

  const updated = LoanRecord {
    borrower: record.borrower,
    lender: record.lender,
    arbiter: record.arbiter,
    termsCommitment: record.termsCommitment,
    status: LoanStatus.repaid,
    createdAt: record.createdAt,
    dueTimestamp: record.dueTimestamp,
    minRatioBps: record.minRatioBps,
    currency: record.currency
  };

  loans.insert(id, updated);
  settlementNullifiers.insert(nullifier, true);
  return receipt;
}

export circuit triggerLiquidation(loanId: Bytes<32>, liquidationHash: Bytes<32>): Bytes<32> {
  const id = disclose(loanId);
  assert(loans.member(id), "Loan not found");
  const record = loans.lookup(id);
  assert(record.status == LoanStatus.funded, "Loan not eligible for liquidation");

  const terms = loanTerms();
  const salt = loanSalt();
  const computed = loanCommitment(terms, record.borrower, salt);
  assert(disclose(computed == record.termsCommitment), "Terms commitment mismatch");

  // Read the authentic oracle price from the on-chain ledger
  assert(assetPrices.member(record.currency), "Price feed missing for currency");
  const currentPrice = assetPrices.lookup(record.currency);

  // Liquidation condition: collateral value dropped below minRatioBps using authentic oracle price
  assert(disclose(!meetsCovenantRatio(terms.collateralAmount, currentPrice, terms.borrowAmount, record.minRatioBps)),
         "Covenant ratio still healthy: liquidation denied");

  const pKey = privateKey();
  const lKey = lenderKey(pKey);
  const aKey = arbiterKey(pKey);
  assert(disclose(lKey == record.lender || aKey == record.arbiter), "Not authorized to liquidate");

  const nullifier = disclose(covenantNullifier(salt, id));
  assert(!settlementNullifiers.member(nullifier), "Loan already settled");

  const receipt = disclose(settlementReceipt(record.termsCommitment, record.lender));

  const updated = LoanRecord {
    borrower: record.borrower,
    lender: record.lender,
    arbiter: record.arbiter,
    termsCommitment: record.termsCommitment,
    status: LoanStatus.liquidated,
    createdAt: record.createdAt,
    dueTimestamp: record.dueTimestamp,
    minRatioBps: record.minRatioBps,
    currency: record.currency
  };

  loans.insert(id, updated);
  settlementNullifiers.insert(nullifier, true);
  liquidationProofs.insert(id, disclose(liquidationHash));
  return receipt;
}
