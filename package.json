{
  "name": "covenant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private debt covenants for institutional credit desks: hidden collateral, provable maintenance ratios and sealed liquidation receipts, compiled for Midnight.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite -c web/vite.config.ts web",
    "build": "vite build -c web/vite.config.ts web",
    "build:web": "vite build -c web/vite.config.ts web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "demo": "tsx ./scripts/demo.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.20.0"
  },
  "devDependencies": {
    "tsx": "~4.23.15",
    "typescript": "~5.9.3",
    "vite": "~5.4.21",
    "vite-plugin-wasm": "~3.6.0",
    "vitest": "~1.6.1"
  },
  "engines": {
    "node": ">=22"
  }
}
