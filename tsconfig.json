{
  "include": ["contract/src", "tests", "scripts", "web/src"],
  "exclude": ["node_modules", "web/dist"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noFallthroughCasesInSwitch": true
  }
}
